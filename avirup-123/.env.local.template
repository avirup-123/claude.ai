# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# Get these from: https://app.supabase.com → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Your project's public URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Your project's anon / public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role secret key — ⚠️  NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini
# Get your API key from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only — ⚠️  NEVER prefix with NEXT_PUBLIC_
GEMINI_API_KEY=<your-gemini-api-key>

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────

# Optional: override the default port (3000)
# PORT=3000

# Optional: set to your Vercel deployment URL for server-side absolute URLs
# VERCEL_URL=your-project.vercel.app
